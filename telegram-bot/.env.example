# Copy to .env — never commit .env
# Per-group toggles + media: DM the bot /start (must be admin in that group). Settings file: bot-settings.json

TELEGRAM_BOT_TOKEN=

# Optional: seed one chat on startup. Otherwise add the bot to group(s); ids are saved in alert-chats.json
# TELEGRAM_CHAT_ID=

# HTTP bridge (backend TELEGRAM_BRIDGE_URL must point here, same port)
TELEGRAM_ALERT_BRIDGE_PORT=3847

# Optional shared secret; if set, backend/.env TELEGRAM_BRIDGE_SECRET must match (header X-Telegram-Bridge-Secret)
# TELEGRAM_BRIDGE_SECRET=

# Block explorer for linked addresses + TX in alerts (no trailing slash). E.g. Ethereum: https://etherscan.io
# TELEGRAM_EXPLORER_BASE=https://bscscan.com

# Site URL for “Powered by Golden Labs” in alert footers (no trailing slash)
# TELEGRAM_GOLDEN_LABS_URL=https://goldenlabs.finance

# Anchor text for “NFT Purchase Alert” transaction link (default: View on BscScan)
# TELEGRAM_TX_VIEW_LABEL=View on BscScan

# Anchor text for subscription alert tx link (default: View Transaction)
# TELEGRAM_SUBSCRIPTION_TX_LABEL=View Transaction

# Anchor text for mint alert tx link (default: View Transaction)
# TELEGRAM_MINT_TX_LABEL=View Transaction

# Optional: match backend USDT_DECIMALS (default 18 for Golden Labs stack).
# USDT_DECIMALS=18

# Optional: one public HTTPS URL per alert kind (image, or .mp4/.webm/.mov for video). Sold falls back to BOUGHT then DEFAULT if unset.
# Per-group media from DM /start overrides these when set (bot-settings.json).
# TELEGRAM_ALERT_MEDIA_USER_JOINED=
# TELEGRAM_ALERT_MEDIA_SUBSCRIPTION=
# TELEGRAM_ALERT_MEDIA_MINT=
# TELEGRAM_ALERT_MEDIA_LISTED=
# TELEGRAM_ALERT_MEDIA_BOUGHT=
# TELEGRAM_ALERT_MEDIA_SOLD=
# TELEGRAM_ALERT_MEDIA_MAINTENANCE=
# TELEGRAM_ALERT_MEDIA_DEFAULT=

# Copy to .env — never commit .env

TELEGRAM_BOT_TOKEN=

# Optional: seed one chat on startup. Otherwise add the bot to group(s); ids are saved in alert-chats.json
# TELEGRAM_CHAT_ID=

# HTTP bridge (backend TELEGRAM_BRIDGE_URL must point here, same port)
TELEGRAM_ALERT_BRIDGE_PORT=3847

# Optional shared secret; if set, backend/.env TELEGRAM_BRIDGE_SECRET must match (header X-Telegram-Bridge-Secret)
# TELEGRAM_BRIDGE_SECRET=

# Block explorer for linked addresses + TX in alerts (no trailing slash). E.g. Ethereum: https://etherscan.io
TELEGRAM_EXPLORER_BASE=https://bscscan.com

# Golden Labs Admin Panel – copy to .env and set values.
# Admin does NOT use Firebase directly; it calls the backend API. Backend .env has Firebase + admins.
#
# Backend API – required for production builds. Must include /api (…:3001/api).
# If unset in dev, the admin app defaults to http://localhost:3001/api.
VITE_API_URL=http://localhost:3001/api

# AppKit metadata URL (optional) – e.g. http://localhost:5174 or https://admin.yourdomain.com
# VITE_ADMIN_URL=

# Reown (WalletConnect) project ID – https://dashboard.reown.com (same as main platform)
VITE_PROJECT_ID=

# Contracts page reads / admin txs — must match deployment of the VITE_* addresses below
# VITE_CHAIN_ID=97

# RPCs (optional – defaults work). Must match VITE_CHAIN_ID (56 → mainnet RPC, 97 → testnet RPC).
# VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org/
# VITE_BSC_TESTNET_RPC_URL=https://bsc-testnet.core.chainstack.com/YOUR_KEY

# Contracts page – optional if backend already has addresses
# VITE_SUBSCRIPTION_CONTRACT_ADDRESS=
# VITE_NFT_CONTRACT_ADDRESS=
# VITE_MARKETPLACE_AND_RESERVE_POOL_CONTRACT_ADDRESS=
# VITE_REFERRAL_CONTRACT_ADDRESS=

# Bots page tuning (optional)
# VITE_BOTS_REFRESH_MS=20000
# VITE_BOTS_REQUEST_TIMEOUT_MS=20000

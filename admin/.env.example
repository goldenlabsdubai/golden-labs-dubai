# Golden Labs Admin — copy to .env. Vite only exposes VITE_* to the browser.
# Universal bots: configure bots/.env (and backend for APIs). Nothing here replaces BOT_* or BOT_LISTING_*.

# Backend API (production: https://your-api.example.com/api). Dev default: http://localhost:3001/api if unset.
VITE_API_URL=http://localhost:3001/api

VITE_PROJECT_ID=

# Production / Vercel: public admin URL (WalletConnect metadata). Required in Vercel env for prod builds.
# Local dev ignores this and uses window.location.origin (localhost).
# VITE_ADMIN_URL=https://your-admin.vercel.app

# Contracts page + wallet: 56 = BSC mainnet, 97 = testnet
VITE_CHAIN_ID=97

# RPCs (optional — viem/appkit have defaults). Use the same chain as VITE_CHAIN_ID.
# VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org/
# VITE_BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

VITE_SUBSCRIPTION_CONTRACT_ADDRESS=
VITE_NFT_CONTRACT_ADDRESS=
VITE_MARKETPLACE_AND_RESERVE_POOL_CONTRACT_ADDRESS=
# VITE_MARKETPLACE_CONTRACT_ADDRESS=
VITE_REFERRAL_CONTRACT_ADDRESS=

# Bots tab: refresh interval and fetch timeout for GET /api/admin/bots
# VITE_BOTS_REFRESH_MS=20000
# VITE_BOTS_REQUEST_TIMEOUT_MS=45000

# Optional token logos on Bots page
# VITE_USDT_LOGO_URL=
# VITE_BNB_LOGO_URL=

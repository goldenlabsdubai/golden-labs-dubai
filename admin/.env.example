# Golden Labs admin (Vite). BSC mainnet only.

VITE_API_URL=http://localhost:3001/api
VITE_PROJECT_ID=
# VITE_ADMIN_URL=https://your-admin-host

VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Must match your deployed USDT token decimals (Golden Labs stack defaults to 18).
VITE_USDT_DECIMALS=18

VITE_SUBSCRIPTION_CONTRACT_ADDRESS=
VITE_NFT_CONTRACT_ADDRESS=
VITE_MARKETPLACE_AND_RESERVE_POOL_CONTRACT_ADDRESS=
VITE_REFERRAL_CONTRACT_ADDRESS=

# Optional; if unset, admin reads USDT address from referral contract `usdt()`.
# VITE_USDT_ADDRESS=

# VITE_BOTS_REFRESH_MS=20000

# Bots – NEVER commit .env (contains private keys!)
RPC_URL=

# Bot private keys – one per bot
BOT1_PRIVATE_KEY=
BOT2_PRIVATE_KEY=
# BOT3_PRIVATE_KEY=
# BOT4_PRIVATE_KEY=
# BOT5_PRIVATE_KEY=

# Contracts (MarketplaceAndReservePoolContract)
MARKETPLACE_AND_RESERVE_POOL_CONTRACT_ADDRESS=
NFT_CONTRACT_ADDRESS=
USDT_ADDRESS=

# Optional tuning — event-driven buyback (see universal-bot.js header)
# CHAIN_ID=97
# BOT_EVENT_PENDING_QUEUE=true
# BOT_SINGLE_CHAIN_LISTENER=true
# Universal listener: which bot runs getLogs = lowest id that admin has "running" (via BOT_CONTROL_BASE_URL). Stops when all stopped.
# Optional override only: BOT_CHAIN_LISTENER_BOT_ID=1
# BOT_SECONDARY_LOCK_DELAY_MS=2500
# BOT_RELIST_RETRY_MIN_MS=60000
# BOT_RELIST_RETRY_MAX_MS=300000
# BOT_BOOTSTRAP_LISTING_SCAN=false
# Production API (root https://api.goldenlabs.finance/api) — bot-control and listing-queue paths:
BOT_CONTROL_BASE_URL=https://api.goldenlabs.finance/api/bot-control
BOT_RECORD_PURCHASE_URL=https://api.goldenlabs.finance/api/marketplace/record-purchase
# BOT_CONTROL_API_KEY=
BOT_LISTING_SOURCE=database
BOT_LISTING_QUEUE_URL=https://api.goldenlabs.finance/api/bot-control/listing-queue
BOT_LISTING_QUEUE_POLL_MS=20000
# Local dev overrides:
# BOT_CONTROL_BASE_URL=http://localhost:3001/api/bot-control
# BOT_RECORD_PURCHASE_URL=http://localhost:3001/api/marketplace/record-purchase
# BOT_LISTING_QUEUE_URL=http://localhost:3001/api/bot-control/listing-queue

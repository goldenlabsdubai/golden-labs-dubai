# Backend – copy to .env and fill values.
# For Vercel: set all vars in Project Settings → Environment Variables.
# Required for Vercel: PGHOST/PGDATABASE/PGUSER/PGPASSWORD, FRONTEND_URL or CORS_ORIGINS, CRON_SECRET.
PORT=3001
JWT_SECRET=your-secret-change-in-production
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# CORS – comma-separated origins allowed to call the API (no hardcoded URLs).
# Examples: http://localhost:5173, https://your-frontend.vercel.app, http://your-ec2-ip:8080
CORS_ORIGINS=

# Admin panel (EC2/same server on port 8080). When set, allows admin UI origin for CORS.
# Example: ADMIN_PANEL_ORIGIN=http://51.21.199.32:8080
# If PLATFORM_URL is set (e.g. http://51.21.199.32), admin origin http://51.21.199.32:8080 is allowed automatically.
ADMIN_PANEL_ORIGIN=

# RPC — e.g. Chainstack BSC testnet: https://bsc-testnet.core.chainstack.com/<YOUR_KEY>
RPC_URL=
BOT_STATS_RPC_URL=

# --- ONE deployment cluster (never mix old + new addresses) ---
# Subscribe, mint, list, and API reads must all use this same set. After redeploy, update ALL of these,
# redeploy backend + frontend + bots, bump MARKETPLACE_INDEXER_FROM_BLOCK / REFERRAL_INDEXER_FROM_BLOCK,
# then verify: curl https://your-api/api/health/contracts matches Vercel VITE_*.
USDT_ADDRESS=
SUBSCRIPTION_CONTRACT_ADDRESS=
NFT_CONTRACT_ADDRESS=
# MarketplaceAndReservePoolContract (marketplace + reserve in one deployment)
MARKETPLACE_AND_RESERVE_POOL_CONTRACT_ADDRESS=
# Optional legacy fallback if unset: MARKETPLACE_CONTRACT_ADDRESS=
# Must match ReferralContract deployment. Frontend needs the same address as VITE_REFERRAL_CONTRACT for buys to pass referrerOf(seller).
REFERRAL_CONTRACT_ADDRESS=
CREATOR_WALLET=

# Bot addresses (for admin panel)
BOT_1_ADDRESS=
BOT_2_ADDRESS=

# NFT metadata
# Production (EC2): set BACKEND_URL=https://api.goldenlabs.finance so avatars and metadata URLs are HTTPS (avoids mixed content).
# If you use one .mp4 for all tokens, set NFT_MP4_CID to that CID so metadata is served from /api/marketplace/nft-metadata/:id (no IPFS proxy needed).
# OR host the clip on the API: place file at backend/uploads/nft-asset.mp4 and set (takes priority over NFT_MP4_CID when both set):
# NFT_LOCAL_ANIMATION_URL=https://api.yourdomain.com/uploads/nft-asset.mp4
# (Requires BACKEND_URL; dashboard/fallback video will use the same URL.)
NFT_METADATA_BASE_URI=
NFT_LOCAL_ANIMATION_URL=
NFT_MP4_CID=
IPFS_GATEWAY=
IPFS_GATEWAY_KEY=
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=

# PostgreSQL (AWS RDS) — required. Run scripts/postgres-schema.sql once on the database.
# Production/EC2: RDS requires SSL (default on).
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
# Optional: set PGSSL=false for local Postgres without SSL
# PGSSL=false

# Indexer blocks (from block explorer)
REFERRAL_INDEXER_FROM_BLOCK=
MARKETPLACE_INDEXER_FROM_BLOCK=
BOT_STATS_FROM_BLOCK=

# My assets API (/marketplace/my-assets) — tune if BSC/RPC is flaky or mint was long ago
MY_ASSETS_TRANSFER_LOOKBACK_BLOCKS=6000000
MY_ASSETS_OWNER_RETRY=5
MY_ASSETS_OWNER_TIMEOUT_MS=12000
MY_ASSETS_ALWAYS_DISCOVER=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cron (Vercel Cron Jobs – set a strong random secret)
# Vercel sends Authorization: Bearer <CRON_SECRET> when triggering cron paths
CRON_SECRET=

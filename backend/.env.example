# Backend – copy to .env and fill values.
# For Vercel: set all vars in Project Settings → Environment Variables.
# Required for Vercel: PGHOST/PGDATABASE/PGUSER/PGPASSWORD, FRONTEND_URL or CORS_ORIGINS, CRON_SECRET.
PORT=3001
JWT_SECRET=your-secret-change-in-production
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# CORS – comma-separated origins allowed to call the API (no hardcoded URLs).
# Examples: http://localhost:5173,https://your-frontend.vercel.app,http://your-ec2-ip:8080
# Admin Vite dev runs on 5174 — localhost 5173/5174 are always allowed unless STRICT_CORS=1.
CORS_ORIGINS=
# Set to 1 to disable automatic localhost:5173/5174 allowance (stricter deployments).
# STRICT_CORS=

# Admin panel (EC2/same server on port 8080). When set, allows admin UI origin for CORS.
# Example: ADMIN_PANEL_ORIGIN=http://51.21.199.32:8080
# If PLATFORM_URL is set (e.g. http://51.21.199.32), admin origin http://51.21.199.32:8080 is allowed automatically.
ADMIN_PANEL_ORIGIN=

# RPC — e.g. Chainstack BSC testnet: https://bsc-testnet.core.chainstack.com/<YOUR_KEY>
RPC_URL=
BOT_STATS_RPC_URL=

# --- ONE deployment cluster (never mix old + new addresses) ---
# Subscribe, mint, list, and API reads must all use this same set. After redeploy, update ALL of these,
# redeploy backend + frontend + bots, bump MARKETPLACE_INDEXER_FROM_BLOCK / REFERRAL_INDEXER_FROM_BLOCK,
# then verify: curl https://your-api/api/health/contracts matches Vercel VITE_*.
USDT_ADDRESS=
SUBSCRIPTION_CONTRACT_ADDRESS=
NFT_CONTRACT_ADDRESS=
# MarketplaceAndReservePoolContract (marketplace + reserve in one deployment)
MARKETPLACE_AND_RESERVE_POOL_CONTRACT_ADDRESS=
# Optional legacy fallback if unset: MARKETPLACE_CONTRACT_ADDRESS=
# Must match ReferralContract deployment. Frontend needs the same address as VITE_REFERRAL_CONTRACT for buys to pass referrerOf(seller).
REFERRAL_CONTRACT_ADDRESS=
# If payout events emit from the merged marketplace contract, set this (BSCScan “events”). Often same as MARKETPLACE_AND_RESERVE_POOL.
# REFERRAL_EVENTS_CONTRACT_ADDRESS=
CREATOR_WALLET=

# Single public host for EC2 (optional). When set, app can derive FRONTEND_URL/BACKEND_URL; also allows admin on :8080 for CORS.
# PLATFORM_URL=

# Bot addresses (for admin panel)
BOT_1_ADDRESS=
BOT_2_ADDRESS=

# Admin GET /api/admin/bots — speed vs RPC load (default: parallel + wallet-only NFT count)
# ADMIN_BOT_STATS_PARALLEL=true
# ADMIN_BOT_STATS_PARALLEL=false
# ADMIN_BOT_STATS_STAGGER_MS=900
# ADMIN_BOTS_FULL_NFT_HOLDINGS=false

# getNftHoldings: prefer Listed(seller) logs then verify few listings() calls (instead of scanning 1..totalMinted)
# BOT_NFT_LISTED_EVENTS_FROM_BLOCK=
# BOT_NFT_LISTED_EVENTS_LOOKBACK_BLOCKS=2000000
# BOT_NFT_LISTED_VERIFY_CAP=600
# Optional: stagger listings() RPC when verifying Listed-token holdings (default 35 ms in code)
# BOT_NFT_LISTING_RPC_STAGGER_MS=35

# Bot stats + Sold indexer (set from block explorer after each deployment)
# BOT_STATS_FROM_BLOCK=
# BOT_STATS_BLOCK_STEP=9
# BOT_STATS_LOOKBACK_BLOCKS=5000
# BOT_STATS_CACHE_TTL_MS=30000
# BOT_STATS_CHUNK_DELAY_MS=0
# BOT_BALANCE_RPC_GAP_MS=400
# MARKETPLACE_INDEXER_FROM_BLOCK=
# MARKETPLACE_INDEXER_POLL_INTERVAL_MS=20000
# MARKETPLACE_INDEXER_CHUNK_DELAY_MS=1000

# My-assets / my-listings scan caps (match NFT MAX_SUPPLY)
# MARKETPLACE_MY_ASSETS_MAX_TOKENS=10000
# MARKETPLACE_MY_ASSETS_MAX_MS=60000

# Optional: same key in bots/.env as BOT_CONTROL_API_KEY — secures bot-control + record-purchase if set
# BOT_CONTROL_API_KEY=

# NFT metadata
# Production (EC2): set BACKEND_URL=https://api.goldenlabs.finance so avatars and metadata URLs are HTTPS (avoids mixed content).
# If you use one .mp4 for all tokens, set NFT_MP4_CID to that CID so metadata is served from /api/marketplace/nft-metadata/:id (no IPFS proxy needed).
# OR host the clip on the API: place file at backend/uploads/nft-asset.mp4 and set (takes priority over NFT_MP4_CID when both set):
# NFT_LOCAL_ANIMATION_URL=https://api.yourdomain.com/uploads/nft-asset.mp4
# (Requires BACKEND_URL; dashboard/fallback video will use the same URL.)
NFT_METADATA_BASE_URI=
NFT_LOCAL_ANIMATION_URL=
NFT_MP4_CID=
IPFS_GATEWAY=
IPFS_GATEWAY_KEY=
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=

# Mint API display (optional; defaults in code: Golden Labs Finance / GLFA)
# NFT_NAME=
# NFT_SYMBOL=

# PostgreSQL (AWS RDS) — required. Run scripts/postgres-schema.sql once on the database.
# Production/EC2: RDS requires SSL (default on).
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
# Optional: set PGSSL=false for local Postgres without SSL
# PGSSL=false

# Indexer blocks (from block explorer)
REFERRAL_INDEXER_FROM_BLOCK=
MARKETPLACE_INDEXER_FROM_BLOCK=
BOT_STATS_FROM_BLOCK=

# My assets API (/marketplace/my-assets) — tune if BSC/RPC is flaky or mint was long ago
MY_ASSETS_TRANSFER_LOOKBACK_BLOCKS=6000000
MY_ASSETS_OWNER_RETRY=5
MY_ASSETS_OWNER_TIMEOUT_MS=12000
MY_ASSETS_ALWAYS_DISCOVER=

# Telegram bridge — telegram-bot HTTP /alert (same host: use 127.0.0.1, not localhost).
# Alerts are sent from DB polling (user_activities, users, marketplace_processed_sales); TELEGRAM_DB_NOTIFIER=0 disables.
# TELEGRAM_LISTINGS_FROM_API=1 (default if unset) also diffs GET /api/marketplace/listings so "listed" Telegram alerts match the app when the chain indexer lags. Set 0 to use only DB indexer rows.
TELEGRAM_LISTINGS_FROM_API=1
# TELEGRAM_DB_NOTIFIER_MS=15000  # poll interval when running long-lived index.js
# Poller-only: skip Telegram if event time is older than this (ms). Default 10800000 (3h). Set 0 to disable stale guard.
# TELEGRAM_POLLER_MAX_EVENT_AGE_MS=10800000
# TELEGRAM_DEBUG=1 logs each forwarded event. If TELEGRAM_BRIDGE_SECRET is set on the bot, set it here too.
# TELEGRAM_BRIDGE_URL=http://127.0.0.1:3847
# TELEGRAM_BRIDGE_SECRET=
# Vercel/serverless: call POST /api/cron/telegram-db-notifier on a schedule (same auth as other cron routes).

# Cron (Vercel Cron Jobs – set a strong random secret)
# Vercel sends Authorization: Bearer <CRON_SECRET> when triggering cron paths
CRON_SECRET=

# Scheduled maintenance overlay (main app): Admin panel → Maintenance. Stored in Postgres (admin_settings.platform_maintenance). No env vars here.

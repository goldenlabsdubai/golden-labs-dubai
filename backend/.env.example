# Backend — copy to .env. Vercel: Project Settings → Environment Variables.
# If you use `source .env` on Linux, any value with spaces MUST be double-quoted (e.g. NFT_NAME="My Token Name").
# BSC mainnet (chain 56). After deploying contracts, set addresses + indexer from-blocks (BscScan creation block).

PORT=3001
JWT_SECRET=your-secret-change-in-production
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

CORS_ORIGINS=
ADMIN_PANEL_ORIGIN=

# Required: pins JsonRpcProvider + must match RPC_URL network
CHAIN_ID=56
# e.g. https://bsc-dataseed.binance.org/ or https://bsc-mainnet.core.chainstack.com/<YOUR_KEY>
RPC_URL=
BOT_STATS_RPC_URL=
# Optional: BSC HTTP URL only for referral indexer, backfill, and /referral/stats on-chain read (eth_getLogs + view calls). Prefer Chainstack; leave RPC_URL on a public seed to limit paid quota.
REFERRAL_RPC_URL=

# USDT smallest-unit scale (18 for Golden Labs mainnet stack; use 6 only for legacy BSC USDT test mocks).
USDT_DECIMALS=18

USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
SUBSCRIPTION_CONTRACT_ADDRESS=
NFT_CONTRACT_ADDRESS=
MARKETPLACE_AND_RESERVE_POOL_CONTRACT_ADDRESS=
REFERRAL_CONTRACT_ADDRESS=
REFERRAL_EVENTS_CONTRACT_ADDRESS=
CREATOR_WALLET=

BOT_1_ADDRESS=
BOT_2_ADDRESS=

ADMIN_BOT_STATS_PARALLEL=true
ADMIN_BOT_STATS_STAGGER_MS=900
ADMIN_BOTS_FULL_NFT_HOLDINGS=false
BOT_NFT_LISTED_EVENTS_FROM_BLOCK=
BOT_NFT_LISTED_EVENTS_LOOKBACK_BLOCKS=2000000
BOT_NFT_LISTED_VERIFY_CAP=600
BOT_BALANCE_RPC_GAP_MS=400
BOT_STATS_FROM_BLOCK=
BOT_STATS_BLOCK_STEP=9
BOT_STATS_LOOKBACK_BLOCKS=5000
BOT_STATS_CACHE_TTL_MS=20000
MARKETPLACE_INDEXER_FROM_BLOCK=
MARKETPLACE_INDEXER_POLL_INTERVAL_MS=20000
MARKETPLACE_INDEXER_CHUNK_DELAY_MS=1000
# GET /api/marketplace/listings: serve cached listings (default 90s); stale on Listed/Sold/Cancel events
MARKETPLACE_LISTINGS_CACHE_TTL_MS=90000
# After RPC 403/rate-limit on listings refresh, return cache only for this cooldown (default 60s)
MARKETPLACE_LISTINGS_RPC_COOLDOWN_MS=60000
MARKETPLACE_LISTINGS_BATCH=25
# First boot scan: one token at a time (gentler on free RPC). Set to 0 for parallel batches.
MARKETPLACE_LISTINGS_WARM_SEQUENTIAL=1
MARKETPLACE_LISTINGS_WARM_DELAY_MS=50

# First BSC block to include when backfilling (inclusive). Same as BscScan “Contract creation” for REFERRAL_CONTRACT_ADDRESS unless ReferralPaid is emitted from a later block.
REFERRAL_INDEXER_FROM_BLOCK=
# Optional: npm run backfill-referral start block; if empty, uses REFERRAL_INDEXER_FROM_BLOCK
REFERRAL_BACKFILL_FROM_BLOCK=
# One-shot script: npm run backfill-referral — widen range slowly if RPC rate-limits (max 2000).
# REFERRAL_BACKFILL_BLOCKS_PER_QUERY=50
# REFERRAL_BACKFILL_CHUNK_DELAY_MS=400

MY_ASSETS_TRANSFER_LOOKBACK_BLOCKS=6000000
MY_ASSETS_OWNER_RETRY=5
MY_ASSETS_OWNER_TIMEOUT_MS=12000
MY_ASSETS_ALWAYS_DISCOVER=true
MY_ASSETS_ENRICH_CONCURRENCY=1
MY_ASSETS_ENRICH_GAP_MS=80
# MY_ASSETS_TRANSFER_LOG_CHUNK_BLOCKS=400000
# MY_ASSETS_MISSING_OWNER_RETRY=8
# MY_ASSETS_SEQUENTIAL_MAX_TOKENS=12
# MY_ASSETS_FULL_CHAIN_SCAN=false
# Must match deployed NFT MAX_SUPPLY (caps metadata + scan ceilings). Optional override for RPC scan limit (see contractsEnv getMarketplaceMyAssetsMaxTokensCeiling).
NFT_MAX_SUPPLY=100000000
MARKETPLACE_MY_ASSETS_MAX_TOKENS=100000000
MARKETPLACE_MY_ASSETS_MAX_MS=60000

NFT_METADATA_BASE_URI=
NFT_LOCAL_ANIMATION_URL=
NFT_MP4_CID=
IPFS_GATEWAY=
IPFS_GATEWAY_KEY=
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=

PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

TELEGRAM_LISTINGS_FROM_API=1
TELEGRAM_BRIDGE_URL=http://127.0.0.1:3847
# Optional: poll interval (ms) to auto-disable maintenance past endsAt and send Telegram resumed (default 60000, min 15000)
# MAINTENANCE_AUTO_END_MS=60000
CRON_SECRET=

# Optional (wei strings). Examples for 18-decimal USDT: 0.75 → 750000000000000000; 10 USDT chunk → 10000000000000000000
# MARKETPLACE_TRADING_INCOME_WEI=750000000000000000
# REFERRAL_WITHDRAW_CHUNK_WEI=10000000000000000000

# Optional: PLATFORM_URL, BACKEND_URL for EC2, TELEGRAM_*, BOT_CONTROL_API_KEY, PGSSL=false, etc.
